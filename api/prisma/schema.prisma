generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EventType {
  routine_completed
  routine_undone
  recall_completed
  feedback_submitted
}

/// One thing that happened on a device. The id is generated by the app, and the
/// primary key is what makes a retried upload harmless.
model Event {
  id         String    @id @db.Uuid
  deviceId   String    @db.Uuid
  type       EventType
  payload    Json
  occurredAt DateTime  @db.Timestamptz(3)
  receivedAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([deviceId, occurredAt])
  @@map("events")
}
